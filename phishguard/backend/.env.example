# PhishGuard Backend Environment Variables
PROJECT_NAME="PhishGuard API"
API_V1_STR="/api"

# Security (Replace with strong random secrets in production)
SECRET_KEY="generate-a-secure-random-32-byte-hex-string-for-jwt-signing"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (Default SQLite for local development)
DATABASE_URL="sqlite:///./phishguard.db"

# Admin Initial Credentials
FIRST_ADMIN_EMAIL="admin@phishguard.internal"
FIRST_ADMIN_PASSWORD="AdminSecurePassword123!"

# CORS Allowed Origins (Frontend React Vite dev server)
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]
